# Raw session evidence stays local; only REPORT.md and extracted JSON are tracked.
# The negations need the DIRECTORIES re-included first: git cannot re-include a file
# whose parent directory is excluded, so `sessions/*` + `!sessions/**/REPORT.md`
# silently tracked nothing (verified 2026-10-14: 0 REPORT.md in the index while one
# existed on disk). `sessions/**` + `!sessions/**/` states the same intent correctly.
sessions/**
!sessions/**/
!sessions/.gitkeep
!sessions/**/REPORT.md
!sessions/**/extracted/*.json
!sessions/**/extracted/remote_json/*.json

sessions/**/*.raw
sessions/**/*.etl
sessions/**/*.pcap
sessions/**/*.pcapng
sessions/**/files/
sessions/**/static/
sessions/**/network/pktmon.etl
sessions/**/network/pktmon.pcapng
sessions/**/logs/Game.log.raw
sessions/**/logs/Game.log.source

# Live-session IDENTITY stays local. The blanket negations above re-include
# REPORT.md and extracted/*.json, and both carry the player name, the Amazon
# persona id, the character UUID and the REP endpoint of a real account. The
# host/path catalogs are generic protocol facts and stay tracked; these are
# account-scoped and do not. Last match wins in gitignore, so these come after
# the negations on purpose. Verified with `git check-ignore` on 2026-10-22.
sessions/**/REPORT.md
sessions/**/extracted/identities.json
sessions/**/extracted/rep_endpoints.json
sessions/**/extracted/remote_json/identities.json

tools/capture/.last-session
_re/*.exe
_re/*.dll

__pycache__/
*.pyc
.venv/
mock_discovery/
**/mock_discovery/

*.log

# Ghidra decompilation output: regenerable with tools/re/decomp.py
derived/decomp/
