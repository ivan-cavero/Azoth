---
import { t, type Locale } from "../data/i18n";

const { locale } = Astro.props as { locale: Locale };
// RoadmapDetail modal — shared by Roadmap.astro (roadmap items) and
// Gantt.astro (deliverables). Content lives in item-details.ts. The modal
// chrome text comes from data-attributes on the mount node (localized).
---

<div
  id="detail-overlay"
  class="fixed inset-0 z-[100] hidden"
  data-labels={JSON.stringify({
    done: locale === "es" ? "HECHO" : "DONE",
    active: locale === "es" ? "EN CURSO" : "ACTIVE",
    investigating: locale === "es" ? "INVESTIGANDO" : "RESEARCH",
    planned: locale === "es" ? "PLANIFICADO" : "PLANNED",
    blocked: locale === "es" ? "BLOQUEADO" : "BLOCKED",
    how: locale === "es" ? "CÓMO" : "HOW",
    depends: locale === "es" ? "DEPENDE DE" : "DEPENDS ON",
    doneLabel: locale === "es" ? "CÓMO SE COMPLETÓ" : "HOW IT WAS COMPLETED",
    evidence: locale === "es" ? "EVIDENCIA" : "EVIDENCE",
    links: locale === "es" ? "ENLACES" : "LINKS",
  })}
>
  <div class="absolute inset-0 bg-void/80 backdrop-blur-sm" data-close></div>
  <div class="absolute inset-x-0 bottom-0 top-14 mx-auto flex max-w-[860px] px-4">
    <div class="card relative flex w-full flex-col overflow-hidden bg-carbon shadow-xl">
      <!-- header -->
      <div class="flex items-start justify-between gap-4 border-b border-graphite/60 px-6 py-4">
        <div class="min-w-0">
          <div class="mono flex items-center gap-2 text-[11px] text-ash">
            <span id="detail-code"></span>
            <span id="detail-badge"></span>
          </div>
          <h3 id="detail-title" class="mt-1 text-[18px] font-medium leading-snug tracking-[-0.012em] text-paper"></h3>
        </div>
        <button
          data-close
          class="mono shrink-0 rounded-md border border-graphite px-2.5 py-1.5 text-[12px] text-mist transition-colors hover:border-smoke"
          aria-label="close"
        >
          ESC
        </button>
      </div>

      <!-- body -->
      <div class="flex-1 overflow-y-auto px-6 py-5" id="detail-body">
        <div id="detail-what" class="text-[14px] leading-relaxed text-mist"></div>

        <div id="detail-how-wrap" class="mt-5 hidden">
          <div class="mono text-[10px] tracking-[0.08em] text-ash" data-label="how">HOW</div>
          <div id="detail-how" class="mt-2 text-[13px] leading-relaxed text-fog"></div>
        </div>

        <div id="detail-depends-wrap" class="mt-5 hidden">
          <div class="mono text-[10px] tracking-[0.08em] text-ash" data-label="depends">DEPENDS ON</div>
          <div id="detail-depends" class="mono mt-2 flex flex-wrap gap-2 text-[12px]"></div>
        </div>

        <div id="detail-completion-wrap" class="mt-6 hidden rounded-lg border border-pulse-green/25 bg-pulse-green/[0.04] p-5">
          <div class="flex items-center gap-2">
            <span class="inline-block h-2 w-2 rounded-[2px] bg-pulse-green"></span>
            <span class="mono text-[10px] tracking-[0.08em] text-pulse-green" data-label="doneLabel">HOW IT WAS COMPLETED</span>
            <span id="detail-completion-date" class="mono text-[10px] text-ash"></span>
          </div>
          <ul id="detail-completion-notes" class="mt-3 space-y-2"></ul>
          <div class="mono mt-4 text-[10px] tracking-[0.08em] text-ash" data-label="evidence">EVIDENCE</div>
          <ul id="detail-completion-evidence" class="mt-2 space-y-1.5"></ul>
          <div id="detail-completion-images" class="mt-4 grid gap-3"></div>
        </div>

        <div id="detail-links-wrap" class="mt-6 hidden">
          <div class="mono text-[10px] tracking-[0.08em] text-ash" data-label="links">LINKS</div>
          <div id="detail-links" class="mt-2 flex flex-wrap gap-2"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import itemDetails, { ganttCodeToItemId } from "../data/item-details";

  const overlay = document.getElementById("detail-overlay")!;
  const els = {
    code: document.getElementById("detail-code")!,
    badge: document.getElementById("detail-badge")!,
    title: document.getElementById("detail-title")!,
    what: document.getElementById("detail-what")!,
    howWrap: document.getElementById("detail-how-wrap")!,
    how: document.getElementById("detail-how")!,
    dependsWrap: document.getElementById("detail-depends-wrap")!,
    depends: document.getElementById("detail-depends")!,
    completionWrap: document.getElementById("detail-completion-wrap")!,
    completionDate: document.getElementById("detail-completion-date")!,
    completionNotes: document.getElementById("detail-completion-notes")!,
    completionEvidence: document.getElementById("detail-completion-evidence")!,
    completionImages: document.getElementById("detail-completion-images")!,
    linksWrap: document.getElementById("detail-links-wrap")!,
    links: document.getElementById("detail-links")!,
  };

  const stateBadgeCls: Record<string, string> = {
    done: "text-pulse-green border-pulse-green/40",
    active: "text-acid-lime border-acid-lime/40",
    investigating: "text-signal-teal border-signal-teal/40",
    planned: "text-fog border-graphite",
    blocked: "text-coral-red border-coral-red/40",
  };

  export interface DetailPayload {
    id: string;
    code: string;
    label: string;
    state: string;
    evidence?: string;
  }

  export function openDetail(p: DetailPayload) {
    const labels = labelsMap();
    const itemId = ganttCodeToItemId[p.id] ?? p.id;
    const d = (itemDetails as Record<string, any>)[itemId];

    els.code.textContent = p.code;
    els.badge.textContent = labels[p.state] ?? p.state.toUpperCase();
    els.badge.className =
      "rounded border px-1.5 py-0.5 text-[9px] tracking-[0.06em] " +
      (stateBadgeCls[p.state] ?? stateBadgeCls.planned);
    els.title.textContent = p.label;
    els.what.textContent =
      p.evidence && !d?.what
        ? p.evidence
        : d?.what ?? p.evidence ?? "";

    // localized static labels
    overlay.querySelectorAll<HTMLElement>("[data-label]").forEach((el) => {
      const key = el.dataset.label!;
      const val = labels[key];
      if (val) el.textContent = val;
    });

    // how
    if (d?.how) {
      els.how.textContent = d.how;
      els.howWrap.classList.remove("hidden");
    } else {
      els.howWrap.classList.add("hidden");
    }

    // depends
    const deps: string[] = d?.dependsOn ?? [];
    if (deps.length) {
      els.depends.innerHTML = deps
        .map(
          (dep) =>
            `<span class="rounded border border-graphite px-2 py-1 text-ash">${dep}</span>`,
        )
        .join("");
      els.dependsWrap.classList.remove("hidden");
    } else {
      els.dependsWrap.classList.add("hidden");
    }

    // completion
    const c = d?.completion;
    if (c) {
      els.completionDate.textContent = c.date ?? "";
      els.completionNotes.innerHTML = (c.notes ?? [])
        .map((n: string) => `<li class="flex gap-2 text-[13px] leading-relaxed text-mist"><span class="text-pulse-green">✓</span><span>${esc(n)}</span></li>`)
        .join("");
      els.completionEvidence.innerHTML = (c.evidence ?? [])
        .map(
          (e: string) =>
            `<li class="mono truncate text-[11px] text-ash" title="${esc(e)}">· ${esc(e)}</li>`,
        )
        .join("");
      els.completionImages.innerHTML = (c.images ?? [])
        .map(
          (img: { src: string; caption: string }) =>
            `<figure class="overflow-hidden rounded-lg border border-graphite">
               <img src="${img.src}" alt="${esc(img.caption)}" class="w-full" loading="lazy" />
               <figcaption class="px-3 py-2 text-[11px] leading-snug text-ash">${esc(img.caption)}</figcaption>
             </figure>`,
        )
        .join("");
      els.completionWrap.classList.remove("hidden");
    } else {
      els.completionWrap.classList.add("hidden");
    }

    // links
    const links = d?.links ?? [];
    if (links.length) {
      els.links.innerHTML = links
        .map(
          (l: { label: string; href: string }) =>
            `<a href="${l.href}" target="_blank" rel="noopener"
                class="mono rounded border border-graphite px-2.5 py-1.5 text-[11px] text-mist transition-colors hover:border-smoke hover:text-paper">
               ${esc(l.label)} ↗</a>`,
        )
        .join("");
      els.linksWrap.classList.remove("hidden");
    } else {
      els.linksWrap.classList.add("hidden");
    }

    overlay.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }

  function closeDetail() {
    overlay.classList.add("hidden");
    document.body.style.overflow = "";
  }

  function esc(s: string): string {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function labelsMap(): Record<string, string> {
    try {
      return JSON.parse(overlay.dataset.labels ?? "{}");
    } catch {
      return {};
    }
  }

  (window as any).openRoadmapDetail = openDetail;

  overlay.querySelectorAll("[data-close]").forEach((el) =>
    el.addEventListener("click", closeDetail),
  );
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !overlay.classList.contains("hidden")) closeDetail();
  });
</script>
