---
import { t, type Locale } from "../data/i18n";

const { locale } = Astro.props as { locale: Locale };
const s = t(locale);
const year = new Date().getFullYear();
---

<footer class="border-t border-graphite/60 py-10">
  <div class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-4 px-4">
    <div class="flex items-center gap-2">
      <svg width="14" height="14" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M9 1L16.5 15.5H1.5L9 1Z" stroke="#8a8f98" stroke-width="1.5" />
      </svg>
      <span class="text-[13px] text-fog">{s.footer.brand}</span>
    </div>
    <div class="mono text-[11px] text-ash">
      {s.footer.data}
    </div>
    <span class="mono text-[11px] text-ash">© {year}</span>
  </div>
</footer>
