# --- runtime / local state ---
.azoth/
*.log
*.log.*
hosts.*
captures/
/sessions/
# --- capture & RE artifacts (regenerable or local-only) ---
*.pcap
*.pcapng
*.etl
*.raw
*.bin
/reverse/builds/
# Keep local workspaces made by older checkouts ignored.
/research/derived/decomp/
!research/derived/*.json
services/gateway/mock_discovery/
services/gateway/traffic.jsonl
services/gateway/traffic-payloads/
services/world/rep_traffic.jsonl
services/world/certs/
deploy/certs/
deploy/caddy_data/
deploy/bin/
# --- editor / OS ---
__pycache__/
*.pyc
.ruff_cache/
.atl/
.pi/
# --- screenshots (discardable, shrunk by scripts/shrink-image.py) ---
*.small.jpg
# --- private client copies (never commit patched game files) ---
private-client/
# --- keep tracked exceptions ---
!launcher/steam_stub/steam_api64.dll
# --- world replay captures (raw dumps stay local) ---
services/world/replay/*
# the redacted capture is the regression fixture for the world tests
!services/world/replay/messages-redacted.txt

# --- landing site build artifacts (source is tracked; dist is generated in CI) ---
site/node_modules/
site/dist/
site/.astro/
site/src/data/repo-facts.gen.json
