# --- project-local runtime (wipe with: python ef.py setup --purge) ---
.azoth/
*.log
*.log.*
hosts.*
captures/
/sessions/

# --- capture & RE artifacts (regenerable or local-only) ---
*.pcap
*.pcapng
*.etl
*.raw
*.bin
/reverse/builds/
/reverse/sessions/
/research/derived/decomp/
!research/derived/*.json
# research/sessions/ rules live in research/.gitignore (REPORT.md exceptions)
# --- service local state (never commit live traffic or certs) ---
services/gateway/mock_discovery/
services/gateway/traffic.jsonl
services/gateway/traffic-payloads/
