# --- project-local runtime (wipe with: python az.py setup --purge) ---
.azoth/
*.log
*.log.*
hosts.*
captures/
/sessions/

# --- capture & RE artifacts (regenerable or local-only) ---
*.pcap
*.pcapng
*.etl
*.raw
*.bin
/reverse/builds/
/reverse/sessions/
/research/derived/decomp/
!research/derived/*.json
# research/sessions/ rules live in research/.gitignore (REPORT.md exceptions)
# --- service local state (never commit live traffic or certs) ---
services/gateway/mock_discovery/
services/gateway/traffic.jsonl
services/gateway/traffic-payloads/
services/world/rep_traffic.jsonl
services/world/certs/
services/world/replay/*
!services/world/replay/messages-redacted.txt
deploy/certs/
deploy/caddy_data/
deploy/bin/

# --- private client copies (never commit patched game files / PAKs) ---
private-client/
!launcher/steam_stub/steam_api64.dll

# --- editor / OS / agent scratch ---
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
.mypy_cache/
.atl/
.pi/
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini
.DS_Store
*.small.jpg

# --- web / dashboards ---
site/node_modules/
site/dist/
site/.astro/
site/src/data/repo-facts.gen.json
**/node_modules/
**/dist/
playwright-report/
test-results/
coverage/

# --- Rust ---
server/target/
**/target/
!server/crates/azoth-wire/tests/fixtures/*.bin

# --- env secrets ---
.env
.env.*
!.env.example
*.pem
!**/testdata/*.pem
